# Copy to .env and fill in. Free keys:
#   EIA:  https://www.eia.gov/opendata/register.php
#   FRED: https://fredaccount.stlouisfed.org/apikeys
# Keys missing here are read from ../situation-monitor/.env (EIA_API_KEY / FRED_API_KEY only).
# Point OGDATA_SHARED_ENV at a different file to change that.
EIA_API_KEY=
FRED_API_KEY=
# Optional: move the data directory off the repo (defaults to ./data)
# OGDATA_DATA=/Volumes/bigdisk/ogdata
