# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Keys missing here are also read from ../situation-monitor/.env (EIA_API_KEY / FRED_API_KEY only) when that
# repo exists next to this one; point OGDATA_SHARED_ENV at a different file to change that.

# ---- data sources (free keys) -----------------------------------------------------------------------
# EIA API v2 (optional: the keyless EIA bulk files already cover the dashboard)   https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# FRED (credit spreads, PPIs, Treasuries, dollar on the dashboard)                 https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ---- local storage ----------------------------------------------------------------------------------
# Where raw downloads, parquet and the DuckDB file live (default: ./data; needs ~20 GB)
# OGDATA_DATA=/Volumes/bigdisk/ogdata

# ---- Databricks back end (work machine; see docs/databricks.md) -------------------------------------
# OGDATA_BACKEND selects where the warehouse lives: duckdb (default, local parquet + DuckDB) or databricks
# (parquet mirrored to a Unity Catalog volume and registered as tables; analytics still run locally in DuckDB).
# OGDATA_BACKEND=databricks
# Workspace URL, no trailing slash
# DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
# Auth: a personal access token OR an OAuth service principal (client id + secret). Leave the unused ones blank.
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# SQL warehouse HTTP path (SQL Warehouses -> Connection details), used for `ogdata sql` against Databricks
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef0123456789
# Unity Catalog target: tables are created as <catalog>.<schema>.<table> (production_monthly, wells, macro_series, ...)
# DATABRICKS_CATALOG=energy
# DATABRICKS_SCHEMA=ogdata
# Volume that receives the parquet lake (same layout as data/parquet/): /Volumes/<catalog>/<schema>/<volume>
# DATABRICKS_VOLUME=/Volumes/energy/ogdata/lake
# Optional: Databricks CLI profile name in ~/.databrickscfg instead of the HOST/TOKEN pair above
# DATABRICKS_CONFIG_PROFILE=work
